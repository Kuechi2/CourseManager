@using CourseManager.Data

@if (SelectedSeats.Any())
{
    <div class="rule-popup shadow border rounded bg-white p-2"
         style="position: absolute; top: 10px; right: 10px; width: 300px; z-index: 1000;">

        <div class="p-2 mb-2 bg-primary text-white rounded small">
            @if (SelectedSeats.Count == 1)
            {
                <span>👤 <b>@SelectedSeats[0].OccupantName</b></span>
            }
            else
            {
                <span>👥 <b>@SelectedSeats.Count Schüler</b> ausgewählt</span>
            }
        </div>

        <div class="list-group list-group-flush overflow-auto" style="max-height: 450px;">
            @foreach (var rule in ActiveRules)
            {
                <button type="button"
                        class="list-group-item list-group-item-action py-2 px-3"
                        @onclick="() => OnRuleSelected.InvokeAsync((rule, SelectedSeats.ToList()))">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold small">
                            @if (rule.Type == RuleType.Timer)
                            {
                                <i class="bi bi-stopwatch me-1 text-warning"></i>
                            }
                            @rule.Name
                            @if (rule.Type == RuleType.Timer && rule.DefaultDurationMinutes.HasValue)
                            {
                                <span class="text-muted ms-1 fw-normal">(@rule.DefaultDurationMinutes min)</span>
                            }
                        </span>
                        <span class="badge @(rule.Points >= 0 ? "bg-success" : "bg-danger")">
                            @(rule.Points > 0 ? "+" : "")@rule.Points
                        </span>
                    </div>
                </button>
            }
        </div>
        <button class="btn btn-sm btn-light w-100 mt-2 border" @onclick="OnCancel">Abbrechen</button>
    </div>
}

@code {
    [Parameter] public List<CanvasSeat> SelectedSeats { get; set; } = new();
    [Parameter] public List<Rule> ActiveRules { get; set; } = new();
    [Parameter] public EventCallback<(Rule Rule, List<CanvasSeat> Seats)> OnRuleSelected { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}