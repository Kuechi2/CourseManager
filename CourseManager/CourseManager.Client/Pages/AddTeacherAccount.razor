@page "/newuser"
@using Microsoft.AspNetCore.Components.Authorization
@* Wir brauchen hier keine Injects für UserManager mehr, das macht die Program.cs! *@

<div class="container mt-5">
    <div class="card mx-auto shadow-sm" style="max-width: 500px;">
        <div class="card-header bg-dark text-white fw-bold">
            <i class="bi bi-person-plus me-2"></i> Neuen Account erstellen
        </div>
        <div class="card-body p-4">

            @* Fehleranzeige aus der URL (falls vorhanden) *@
            @if (ShowError)
            {
                <div class="alert alert-danger small">
                    @ErrorMessage
                </div>
            }

            @* Das hier ist der "Arbeitstier"-Teil: Ein klassischer POST *@
            <form action="/auth/register" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">Vorname</label>
                        <input name="firstName" class="form-control form-control-sm" placeholder="Lord" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">Nachname</label>
                        <input name="lastName" class="form-control form-control-sm" placeholder="K" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Kürzel (ShortName)</label>
                    <input name="shortName" class="form-control form-control-sm" placeholder="KÜC" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">E-Mail Adresse</label>
                    <input name="email" type="email" class="form-control form-control-sm" placeholder="name@schule.de" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Passwort</label>
                    <input name="password" type="password" class="form-control form-control-sm" required />
                </div>

                <button type="submit" class="btn btn-success w-100 mt-2">
                    <i class="bi bi-check-circle me-1"></i> Registrieren
                </button>
            </form>
        </div>
        <div class="card-footer text-center small text-muted">
            Bereits einen Account? <a href="/login">Hier anmelden</a>
        </div>
    </div>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private bool ShowError => Nav.Uri.Contains("error=");
    private string ErrorMessage => Nav.Uri.Contains("invalid_input")
        ? "Bitte alle Felder ausfüllen."
        : "Registrierung fehlgeschlagen. E-Mail bereits vergeben?";
}